#!/bin/bash
set -e -u -o pipefail
#set -x
: "${DMC_FORMAT:=tabs}"
: "${S3L_SCHEMA:=l_}"
: "${S3L_SUFFIX:=}"
: "${S3L_DEBUG:=}"
: "${DMC_UNARCHIVE:=unzip -p}"
: "${DMC_ENCODING:=UTF-8}"
export DMC_FORMAT S3L_SCHEMA S3L_SUFFIX S3L_DEBUG DMC_UNARCHIVE DMC_ENCODING DMC_FIXNULL DMC_QUOTEQUOTE
Main() {
	local db="$1" file="$2" part="${3:-}" rc=0
	Load "$file" "$part" 1>&2
	sqlite3 "$db" -init <(Load "$file" "$part") ".exit" || rc="$?"
	echo "$rc"
	if [[ "$rc" -gt 0 ]] && [[ -n "${S3L_DEBUG}" ]]; then
		DebugSummary "$@"
	fi
	return "$rc"
}
Load() {
	local table file="$1" part="${2:-}"
	table="$(Table "$file" "$part")"
	echo ".echo on"
	echo ".changes on"
	echo ".timer on"
	echo ".mode ${DMC_FORMAT}"
	# Quoting is needed due to the schema
	echo "DROP TABLE IF EXISTS '$table';";
	# This breaks on filenames with spaces
	echo ".import \"| dmclean '$file'${part:+ \'$part\'}\" $table"
}
Table() {
	local file="$1" part="${2:-}" cfile='' cpart='' base=''
	cfile=$(CleanName "$file")
	cpart=$(CleanName "$part")
	if [ -z "$cpart" ] || [ "${cfile/$cpart/}" != "${cfile}" ]; then
		base="$cfile"
	else
		base="${cfile}_${cpart}"
	fi
	echo "${S3L_SCHEMA,,}$base${S3L_SUFFIX:+_${S3L_SUFFIX,,}}"
}
CleanName() {
	local name="$1"
	local basename="${name##*/}"
	local noext="${basename%.*}"
	local nospecial="${noext//[-_ ]/}"
	local lower="${nospecial,,}"
	echo "$lower"
}
DebugSummary() {
	local table
	table="$(Table "$@")"
	dmclean "$@" | debugsummary > "$table.${DMC_FORMAT}"
}
Main "$@"
